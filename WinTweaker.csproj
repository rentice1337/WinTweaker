<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WinTweaker</AssemblyName>
    <RootNamespace>WinTweaker</RootNamespace>

    <!-- Версия подставляется из git-тега при релизе (-p:Version=1.2.3) -->
    <Version>1.0.0</Version>
    <Product>WinTweak</Product>
    <Company>rentice1337</Company>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Authors>rentice1337</Authors>
    <AssemblyTitle>WinTweak — настройка Windows 10 и игр</AssemblyTitle>
    <Description>WinTweak — настройка Windows 10 и игр</Description>
    <Copyright>© 2026 rentice1337. Все права защищены.</Copyright>
    <RepositoryUrl>https://github.com/rentice1337/WinTweaker</RepositoryUrl>
  </PropertyGroup>

  <!-- Один самодостаточный .exe: dotnet publish -c Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
